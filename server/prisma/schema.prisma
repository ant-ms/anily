generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum AnimeFormat {
  MOVIE
  ONA
  ONE_SHOT
  OVA
  SPECIAL
  TV
  TV_SHORT
}

enum AnimeSeason {
  WINTER
  SPRING
  SUMMER
  FALL
}

model BaseAnime {
  anilistId   Int         @id
  malId       Int?
  lastUpdated BigInt
  format      AnimeFormat

  titleEnglish String?
  titleNative  String?
  titleRomanji String?
  synonyms     AnimeSynonym[]
  season       AnimeSeason?
  seasonYear   Int?

  relationsOut        AnimeRelation[] @relation("RelationFrom")
  relationsIn         AnimeRelation[] @relation("RelationTo")
  animeDetails        AnimeDetails?
  groupings           AnimeGrouping[] @relation("GroupingItems")
  displayForGroupings AnimeGrouping[] @relation("GroupingDisplayAnime")

  @@index([titleEnglish(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([titleRomanji(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([titleNative(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum AnimeRelationType {
  ADAPTATION
  PREQUEL
  SEQUEL
  PARENT
  SIDE_STORY
  ALTERNATIVE
  SPIN_OFF
  OTHER
  SOURCE
  CONTAINS
}

model AnimeRelation {
  id           Int               @id @default(autoincrement())
  relationType AnimeRelationType

  fromAnime   BaseAnime @relation("RelationFrom", fields: [fromAnimeId], references: [anilistId])
  fromAnimeId Int
  toAnime     BaseAnime @relation("RelationTo", fields: [toAnimeId], references: [anilistId])
  toAnimeId   Int

  @@unique([fromAnimeId, toAnimeId, relationType])
  @@index([fromAnimeId])
  @@index([toAnimeId])
}

model AnimeSynonym {
  id      Int    @id @default(autoincrement())
  animeId Int
  text    String

  anime BaseAnime @relation(fields: [animeId], references: [anilistId])

  @@unique([animeId, text])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([animeId])
}

model AnimeDetails {
  id                 Int       @id @default(autoincrement())
  baseAnime          BaseAnime @relation(fields: [baseAnimeAnilistId], references: [anilistId])
  baseAnimeAnilistId Int       @unique

  groupingOrder Int?
  groupingId    Int?

  thumbnailUrl String?
  description  String?
  episodes     Episode[]

  @@unique([groupingId, groupingOrder])
  @@index([groupingId])
}

model AnimeGrouping {
  id             Int         @id @default(autoincrement())
  items          BaseAnime[] @relation("GroupingItems")
  displayAnime   BaseAnime   @relation("GroupingDisplayAnime", fields: [displayAnimeId], references: [anilistId])
  displayAnimeId Int
}

enum SyncJobTrigger {
  SCHEDULED
  MANUAL
}

enum SyncJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum MediaStatus {
  NONE
  QUEUED
  DOWNLOADING
  AVAILABLE
}

model SyncJob {
  id          Int            @id @default(autoincrement())
  trigger     SyncJobTrigger
  status      SyncJobStatus
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  updatesCount Int?
  error       String?
}

model Episode {
  id             Int          @id @default(autoincrement())
  animeDetails   AnimeDetails @relation(fields: [animeDetailsId], references: [id], onDelete: Cascade)
  animeDetailsId Int

  number   Int
  airingAt DateTime?

  titleEnglish String?
  titleNative  String?
  titleRomanji String?

  thumbnailUrl String?

  watched Boolean @default(false)

  mediaStatus          MediaStatus @default(NONE)
  mediaPath            String?     // relative path within media volume, e.g. "21234/ep01/[SubsPlease] Show - 01.mkv"
  mediaTorrentHash     String?     // qBittorrent torrent hash
  mediaSize            BigInt?     // file size in bytes once available
  mediaSelectedTorrent Json?       // stored torrent selection info (title, seeders, etc.)
  mediaLastSearchAt    DateTime?   // last time search was performed

  @@unique([animeDetailsId, number])
  @@index([animeDetailsId])
  @@index([mediaTorrentHash])
}
