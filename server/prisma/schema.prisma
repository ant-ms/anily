generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum AnimeFormat {
  MOVIE
  ONA
  ONE_SHOT
  OVA
  SPECIAL
  TV
  TV_SHORT
}

enum AnimeSeason {
  WINTER
  SPRING
  SUMMER
  FALL
}

enum Rating {
  LIKE
  NEUTRAL
  DISLIKE
}

model BaseAnime {
  anilistId   Int         @id
  malId       Int?
  lastUpdated BigInt
  format      AnimeFormat

  titleEnglish String?
  titleNative  String?
  titleRomanji String?
  synonyms     AnimeSynonym[]
  season       AnimeSeason?
  seasonYear   Int?

  relationsOut        AnimeRelation[]   @relation("RelationFrom")
  relationsIn         AnimeRelation[]   @relation("RelationTo")
  animeDetails        AnimeDetails?
  groupings           AnimeGrouping[]   @relation("GroupingItems")
  displayForGroupings AnimeGrouping[]   @relation("GroupingDisplayAnime")
  bookmarks           UserBookmark[]
  ratings             UserAnimeRating[]

  @@index([titleEnglish(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([titleRomanji(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([titleNative(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum AnimeRelationType {
  ADAPTATION
  PREQUEL
  SEQUEL
  PARENT
  SIDE_STORY
  ALTERNATIVE
  SPIN_OFF
  OTHER
  SOURCE
  CONTAINS
}

model AnimeRelation {
  id           Int               @id @default(autoincrement())
  relationType AnimeRelationType

  fromAnime   BaseAnime @relation("RelationFrom", fields: [fromAnimeId], references: [anilistId])
  fromAnimeId Int
  toAnime     BaseAnime @relation("RelationTo", fields: [toAnimeId], references: [anilistId])
  toAnimeId   Int

  @@unique([fromAnimeId, toAnimeId, relationType])
  @@index([fromAnimeId])
  @@index([toAnimeId])
}

model AnimeSynonym {
  id      Int    @id @default(autoincrement())
  animeId Int
  text    String

  anime BaseAnime @relation(fields: [animeId], references: [anilistId])

  @@unique([animeId, text])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([animeId])
}

model AnimeDetails {
  id                 Int       @id @default(autoincrement())
  baseAnime          BaseAnime @relation(fields: [baseAnimeAnilistId], references: [anilistId])
  baseAnimeAnilistId Int       @unique

  groupingOrder Int?
  groupingId    Int?

  thumbnailUrl String?
  description  String?
  episodes     Episode[]
  rating       Rating    @default(NEUTRAL)

  @@unique([groupingId, groupingOrder])
  @@index([groupingId])
}

model AnimeGrouping {
  id             Int         @id @default(autoincrement())
  items          BaseAnime[] @relation("GroupingItems")
  displayAnime   BaseAnime   @relation("GroupingDisplayAnime", fields: [displayAnimeId], references: [anilistId])
  displayAnimeId Int
}

enum SyncJobType {
  ANILIST_SYNC
  EPISODE_METADATA
}

enum SyncJobTrigger {
  SCHEDULED
  MANUAL
}

enum SyncJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum MediaStatus {
  NONE
  QUEUED
  DOWNLOADING
  AVAILABLE
}

model SyncJob {
  id           Int            @id @default(autoincrement())
  type         SyncJobType    @default(ANILIST_SYNC)
  trigger      SyncJobTrigger
  status       SyncJobStatus
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  updatesCount Int?
  details      Json?
  error        String?
}

model Episode {
  id             Int          @id @default(autoincrement())
  animeDetails   AnimeDetails @relation(fields: [animeDetailsId], references: [id], onDelete: Cascade)
  animeDetailsId Int

  number   Int
  airingAt DateTime?

  titleEnglish String?
  titleNative  String?
  titleRomanji String?

  thumbnailUrl String?

  watched Boolean @default(false)
  userProgress UserEpisodeProgress[]

  mediaStatus          MediaStatus @default(NONE)
  mediaPath            String?     // relative path within media volume, e.g. "21234/ep01/[SubsPlease] Show - 01.mkv"
  mediaTorrentHash     String?     // qBittorrent torrent hash
  mediaSize            BigInt?     // file size in bytes once available
  mediaSelectedTorrent Json?       // stored torrent selection info (title, seeders, etc.)
  mediaLastSearchAt    DateTime?   // last time search was performed
  mediaFailedTorrents  String[]    @default([]) // blacklisted torrent links/titles that stalled or failed

  @@unique([animeDetailsId, number])
  @@index([animeDetailsId])
  @@index([mediaTorrentHash])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  sub       String?  @unique
  name      String?
  createdAt DateTime @default(now())

  episodeProgress UserEpisodeProgress[]
  bookmarks       UserBookmark[]
  ratings         UserAnimeRating[]
}

model UserEpisodeProgress {
  id        Int      @id @default(autoincrement())
  userId    String
  episodeId Int
  watched   Boolean  @default(true)
  watchedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
  @@index([episodeId])
}

model UserBookmark {
  id        Int      @id @default(autoincrement())
  userId    String
  anilistId Int
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseAnime BaseAnime @relation(fields: [anilistId], references: [anilistId], onDelete: Cascade)

  @@unique([userId, anilistId])
  @@index([userId])
  @@index([anilistId])
}

model UserAnimeRating {
  id        Int      @id @default(autoincrement())
  userId    String
  anilistId Int
  rating    Rating   @default(NEUTRAL)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseAnime BaseAnime @relation(fields: [anilistId], references: [anilistId], onDelete: Cascade)

  @@unique([userId, anilistId])
  @@index([userId])
  @@index([anilistId])
}

