generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model BaseAnime {
  anilistId   Int    @id
  malId       Int?
  lastUpdated BigInt

  titleEnglish String?
  titleNative  String?
  titleRomanji String?
  synonyms     AnimeSynonym[]

  relatedAnime  BaseAnime[]         @relation("BaseAnimeRelations")
  relatedToBy   BaseAnime[]         @relation("BaseAnimeRelations")
  detailedAnime DetailedAnime?
  groupingItems AnimeGroupingItem[]

  @@index([titleEnglish(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([titleRomanji(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([titleNative(ops: raw("gin_trgm_ops"))], type: Gin)
}

model AnimeSynonym {
  id      Int    @id @default(autoincrement())
  animeId Int
  text    String

  anime BaseAnime @relation(fields: [animeId], references: [anilistId])

  @@unique([animeId, text])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([animeId])
}

enum Rating {
  LIKE
  NEUTRAL
  DISLIKE
}

model Episode {
  id Int @id @default(autoincrement())

  titleEnglish String?
  titleNative  String?
  titleRomanji String?

  thumbnailUrl String?

  watched Boolean @default(false)
}

model AnimeGrouping {
  id    Int             @id @default(autoincrement())
  items DetailedAnime[]
}

model DetailedAnime {
  id                 Int       @id @default(autoincrement())
  baseAnime          BaseAnime @relation(fields: [baseAnimeAnilistId], references: [anilistId])
  baseAnimeAnilistId Int       @unique

  groupingOrder Int?
  groupingId    Int?
  grouping      AnimeGrouping? @relation(fields: [groupingId], references: [id], onDelete: Cascade)

  thumbnailUrl String?
  description  String?

  rating         Rating
  markedForLater Boolean

  @@unique([groupingId, groupingOrder])
  @@index([groupingId])
}

model AnimeGroupingItem {
  id          Int       @id @default(autoincrement())
  order       Int
  baseAnimeId Int
  baseAnime   BaseAnime @relation(fields: [baseAnimeId], references: [anilistId], onDelete: Cascade)
}
