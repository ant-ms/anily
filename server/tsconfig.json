{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["lib/*"],
      "$src/*": ["src/*"],
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
  },
}
